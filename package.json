{
  "name": "@infranodus/mcp-app",
  "version": "2.0.0",
  "description": "InfraNodus MCP App — Interactive knowledge graph visualization",
  "type": "module",
  "scripts": {
    "build:ui": "vite build && cp mcp-app.html dist/mcp-app.html",
    "build:3d": "vite build --config vite.config.3d.ts",
    "build:check": "tsc --noEmit",
    "build": "npm run build:ui && npm run build:3d && npm run build:check",
    "dev": "tsx --watch main.ts",
    "dev:ui": "vite build --watch",
    "start": "node --import tsx main.ts",
    "start:stdio": "node --import tsx main.ts --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "3d-force-graph": "^1.80.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.0",
    "sigma": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
